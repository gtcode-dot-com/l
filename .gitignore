# Only GitHub Pages sources belong in this repository.
/*
!/.gitignore
!/.github/
!/hugo-site/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy-hugo.yml

/hugo-site/*
!/hugo-site/assets/
!/hugo-site/content/
!/hugo-site/data/
!/hugo-site/layouts/
!/hugo-site/static/
!/hugo-site/themes/
!/hugo-site/config/
!/hugo-site/i18n/
!/hugo-site/.hugo-version
!/hugo-site/config.toml
!/hugo-site/config.yaml
!/hugo-site/config.yml
!/hugo-site/config.json
!/hugo-site/hugo.toml
!/hugo-site/hugo.yaml
!/hugo-site/hugo.yml
!/hugo-site/hugo.json
!/hugo-site/package.json
!/hugo-site/package-lock.json
!/hugo-site/npm-shrinkwrap.json
!/hugo-site/postcss.config.js
!/hugo-site/scripts/
/hugo-site/scripts/*
!/hugo-site/scripts/generate_repo_pages.py

node_modules/
__pycache__/
*.pyc
.env
.DS_Store
Thumbs.db
